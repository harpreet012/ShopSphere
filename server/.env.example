# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://jakharharpreet94_db_user:Harpreet123@cluster0.66o4tug.mongodb.net/shopsphere?appName=Cluster0

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_key

# Frontend URL (CORS)
CLIENT_URL=http://localhost:5173

# ─── Nodemailer / Gmail SMTP ──────────────────────────────────────────────────
# Use a Gmail account with an App Password (not your normal login password).
# How to get an App Password:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate a password for "Mail" → paste it as SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="ShopSphere <your-gmail@gmail.com>"

# ─── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
